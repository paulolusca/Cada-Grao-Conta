# Arquivo de exemplo de variáveis de ambiente
# Copie este arquivo para .env.local e substitua os valores pelos seus.
# IMPORTANTE: Para que o Vite exponha as variáveis ao cliente, elas DEVEM começar com VITE_

# Configuração do Firebase
VITE_FIREBASE_API_KEY="coloque_sua_chave_aqui"
VITE_FIREBASE_AUTH_DOMAIN="coloque_seu_dominio_aqui"
VITE_FIREBASE_PROJECT_ID="coloque_seu_id_de_projeto_aqui"
VITE_FIREBASE_STORAGE_BUCKET="coloque_seu_storage_bucket_aqui"
VITE_FIREBASE_MESSAGING_SENDER_ID="coloque_seu_sender_id_aqui"
VITE_FIREBASE_APP_ID="coloque_seu_app_id_aqui"

# Configuração da API do Gemini
VITE_GEMINI_API_KEY="coloque_sua_chave_aqui"
